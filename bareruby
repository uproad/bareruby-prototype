#!/usr/bin/env ruby
# frozen_string_literal: true

# Running this checkout rather than an installed copy of it.
#
# The two gems this repository *is* are read from the working tree, so that editing a pass
# and running the command stays one step. The gems it merely *has* — bindings, standard
# classes — are read from where a gem is read, which is what .gems/ is for, filed under the
# repository for the same reason .tools/ is: what a run reaches for is the run's, and a
# checkout that has to be told where its own bindings are has been left half-installed.
# A desk that installs them the ordinary way is served too; this only adds a place to look.
#
# **The command itself is not here.** It is the executable the ecosystem gem ships, run
# from where it lives, so that this file cannot drift from what a user gets.
%w[bareruby_prot bareruby_prot-compiler].each do |made_of|
  $LOAD_PATH.unshift(File.expand_path("gems/#{made_of}/lib", __dir__))
end

GEMS = File.expand_path(".gems", __dir__)
Gem.use_paths(Gem.dir, [*Gem.path, GEMS]) if Dir.exist?(GEMS)

load File.expand_path("gems/bareruby_prot/exe/bareruby", __dir__)
