/* Generated from <%= device.key %> (<%= device.part %>) — the memory is the device
 * manifest's answer, the section layout is this family's. The symbol names are the
 * ones the ST startup file initializes by, so they are not this file's to rename. */

ENTRY(Reset_Handler)

_estack = ORIGIN(<%= main.name %>) + LENGTH(<%= main.name %>);

_Min_Heap_Size = <%= format("0x%x", heap) %>;
_Min_Stack_Size = <%= format("0x%x", stack) %>;

MEMORY
{
<% device.memory.each do |region| -%>
  <%= region.name.ljust(width) %> (<%= region.kind == "flash" ? "rx" : "xrw" %>) : ORIGIN = <%= format("0x%08x", region.origin) %>, LENGTH = <%= region.size / 1024 %>K
<% end -%>
}

SECTIONS
{
  .isr_vector :
  {
    . = ALIGN(4);
    KEEP(*(.isr_vector))
    . = ALIGN(4);
  } ><%= flash.name %>

  .text :
  {
    . = ALIGN(4);
    *(.text)
    *(.text*)
    *(.glue_7)
    *(.glue_7t)
    *(.eh_frame)
    KEEP (*(.init))
    KEEP (*(.fini))
    . = ALIGN(4);
    _etext = .;
  } ><%= flash.name %>

  .rodata :
  {
    . = ALIGN(4);
    *(.rodata)
    *(.rodata*)
    . = ALIGN(4);
  } ><%= flash.name %>

  /* The unwinder's tables. Present even in a -fno-exceptions build, where they are
   * merely empty rather than a special case. */
  .ARM.extab (READONLY) :
  {
    . = ALIGN(4);
    *(.ARM.extab* .gnu.linkonce.armextab.*)
    . = ALIGN(4);
  } ><%= flash.name %>

  .ARM (READONLY) :
  {
    . = ALIGN(4);
    __exidx_start = .;
    *(.ARM.exidx*)
    __exidx_end = .;
    . = ALIGN(4);
  } ><%= flash.name %>

  .preinit_array (READONLY) :
  {
    . = ALIGN(4);
    PROVIDE_HIDDEN (__preinit_array_start = .);
    KEEP (*(.preinit_array*))
    PROVIDE_HIDDEN (__preinit_array_end = .);
    . = ALIGN(4);
  } ><%= flash.name %>

  .init_array (READONLY) :
  {
    . = ALIGN(4);
    PROVIDE_HIDDEN (__init_array_start = .);
    KEEP (*(SORT(.init_array.*)))
    KEEP (*(.init_array*))
    PROVIDE_HIDDEN (__init_array_end = .);
    . = ALIGN(4);
  } ><%= flash.name %>

  .fini_array (READONLY) :
  {
    . = ALIGN(4);
    PROVIDE_HIDDEN (__fini_array_start = .);
    KEEP (*(SORT(.fini_array.*)))
    KEEP (*(.fini_array*))
    PROVIDE_HIDDEN (__fini_array_end = .);
    . = ALIGN(4);
  } ><%= flash.name %>

  _sidata = LOADADDR(.data);

  .data :
  {
    . = ALIGN(4);
    _sdata = .;
    *(.data)
    *(.data*)
    *(.RamFunc)
    *(.RamFunc*)
    . = ALIGN(4);
    _edata = .;
  } ><%= main.name %> AT> <%= flash.name %>

  . = ALIGN(4);
  .bss :
  {
    _sbss = .;
    __bss_start__ = _sbss;
    *(.bss)
    *(.bss*)
    *(COMMON)
    . = ALIGN(4);
    _ebss = .;
    __bss_end__ = _ebss;
  } ><%= main.name %>

  ._user_heap_stack :
  {
    . = ALIGN(8);
    PROVIDE ( end = . );
    PROVIDE ( _end = . );
    . = . + _Min_Heap_Size;
    . = . + _Min_Stack_Size;
    . = ALIGN(8);
  } ><%= main.name %>
<% extras.each do |region| -%>

  /* <%= region.name %> stays a region of its own — different bus reach, and on this
   * family the DMA cannot see it. Reached by placing into the section by name. */
  .<%= region.name.downcase %> (NOLOAD) :
  {
    . = ALIGN(4);
    *(.<%= region.name.downcase %>)
    *(.<%= region.name.downcase %>*)
    . = ALIGN(4);
  } ><%= region.name %>
<% end -%>

  /DISCARD/ :
  {
    libc.a ( * )
    libm.a ( * )
    libgcc.a ( * )
  }

  .ARM.attributes 0 : { *(.ARM.attributes) }
}
