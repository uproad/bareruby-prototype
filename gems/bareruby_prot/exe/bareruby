#!/usr/bin/env ruby
# frozen_string_literal: true

# The one executable. Every command a user types arrives here, and nothing else in the
# ecosystem is reachable from a shell.
#
# The project is found before anything else is loaded: what the compiler writes, it writes
# beside where it was run, and where that is gets settled the moment it is required.
require "bareruby_prot/project"
BareRubyProt::Project.stand(ARGV)

require "bareruby_prot/cli"

# A refusal is printed as the sentence it is; anything else keeps its backtrace, because
# an exception nobody planned for is a bug here and the frames are the report.
begin
  exit BareRubyProt::Cli.run(ARGV)
rescue BareRubyProt::Stop => e
  warn "bareruby: #{e.message}"
  exit 1
end
