# frozen_string_literal: true

source "https://rubygems.org"

# Specify your gem's dependencies in bareruby_prot-stdlib-uart.gemspec
gemspec

gem "rspec", "~> 3.13"

# Which compiler this suite runs against is not this file's decision and not the gemspec's
# either. The gemspec names the gem and the versions this one works with; a released gem
# comes from rubygems by that name. This only says: if a compiler is checked out next door,
# that is the one to read — which is true of every checkout of this repository, and true
# again anywhere someone puts one there deliberately. Nothing here changes when the gems
# move apart; the directory simply stops being there.
local_compiler = File.expand_path("../bareruby_prot-compiler", __dir__)
gem "bareruby_prot-compiler", path: local_compiler if Dir.exist?(local_compiler)
