# This file is not meant to be written by hand:
#
#     ./bareruby target add
#
# asks which board it is — first roughly, by the family its maker sells it in, then
# exactly — and writes the answer here. Nothing in an entry has to be looked up, which is
# the point: a triple is not something a Ruby programmer new to microcontrollers should
# have to go and find out. `./bareruby target list` prints every board that can be named.
#
# A project written by `./bareruby new` arrives with this file already holding one entry —
# the machine doing the compiling — so that it builds and runs before a board is attached.
# This checkout is not one of those projects, so what is kept here is the shape of what
# that command writes, for reading a file back and correcting it once it exists. Copy it
# to config/target.yml, which is not tracked here: which boards are attached, and where an
# external project lives, is true of one desk rather than of this repository. In a project
# written by `new` it is tracked, because which compositions a project is built for is
# true of the project.
#
# Every command that builds anything — `compile`, `build`, `flash`, `deploy` — takes its
# targets from here, and `--target=NAME` picks out one of the entries below by its name.
# With no --target, every entry is worked on. `compile` reaches for no toolchain, which is
# what it is spared; knowing where it stands is not.
#
# An entry names a composition rather than a target, and always names all three parts of
# it, because no one of them settles another. One board is reachable through more than one
# binding — an ESP32-S3 through ESP-IDF or through the Arduino core — and one whose chip
# carries two instruction sets is built for either of them, as an RP2350 is for Arm or for
# RISC-V. The three together are looked up: a composition nobody has run is not a target
# yet, and saying one names nothing prints the ones that do.
#
#   machine:  which board.        pico, pico_w, pico2, pico2_w, nucleo_f446re,
#                                 nucleo_f401re, stm32f4discovery, mega2560,
#                                 esp32_s3_wroom, host (the machine doing the compiling)
#   binding:  what it is called through.  host, pico_sdk, stm32cube, arduino, esp_idf
#   triple:   which instruction set, and what lies under it.
#               thumbv6m-none-eabi           RP2040
#               thumbv8m.main-none-eabihf    RP2350, Arm
#               thumbv7em-none-eabihf        STM32F4
#               avr-none                     AVR. The chip is named by the FQBN, not here
#               xtensa-esp32s3-elf           ESP32-S3
#               x86_64-pc-linux              the machine doing the compiling
#   name:     what this entry is called. It is what --target= says, what its directory
#             under build/ is called, and what the line saying where the artifact went
#             prints — one word wherever this entry is met. It is also what lets one
#             composition be recorded twice, as a debug build and a release build of the
#             same board. `bareruby target add` writes one whether or not one is typed:
#             left blank it puts down <machine>-<binding>-<triple>, which is long because
#             that is how much it takes to be unique.
#   debug:    optional. `true` or `1` and nothing else means a debug build; anything
#             else, and saying nothing, means release.
#   boards:   optional, and usually best left out. With nothing here the one attached
#             board the artifact fits is found and written, because the image says which
#             chip it is for. Name serials only when two boards carry the same chip.
#
#             A serial is not always a lasting name for a board. An RP2040 reports the
#             bootrom's id while it is in BOOTSEL and the flash id once it is running, so
#             one written down here matches in one of those states and not in the other —
#             which looks exactly like the board having been unplugged. An RP2350 reports
#             one number for both. There is nothing to look up to fill this in: flashing
#             refuses when two boards carry one chip and prints the serials it found.
#
#             `bareruby target attach --target=<this entry>` removes the question instead:
#             it writes this entry's own name into the board, and the board reports that
#             name from then on. What goes here is then the name above rather than a
#             number nobody chose.
#   options:  optional. What only this desk knows, passed to the binding that needs it.
#
# The first three fields of an entry are true of the project; boards and options are true
# of one desk. They live in one file until a second desk needs them not to.

targets:
  # Nothing is flashed, because the artifact is already on the machine that runs it. A
  # project written by `new` arrives with this entry and nothing else, so that it builds
  # before a board is attached; this checkout writes its own, so here it is written out.
  - name: host
    machine: host
    binding: host
    triple: x86_64-pc-linux

  - name: pico
    machine: pico
    binding: pico_sdk
    triple: thumbv6m-none-eabi
    debug: true

  - name: pico2w
    machine: pico2_w
    binding: pico_sdk
    triple: thumbv8m.main-none-eabihf

  # Two builds of one composition, so each one says which it is.
  # - name: pico2-release
  #   machine: pico2
  #   binding: pico_sdk
  #   triple: thumbv8m.main-none-eabihf

  # The CubeIDE project is generated and configured by the user, and sits under
  # .tools/stm32cube/ with everything else a build reaches for. One there needs no
  # naming; cube_project is for a desk keeping several, or keeping its own elsewhere.
  # boards: takes ST-LINK probe serials rather than board serials, because SWD is
  # reached through the probe.
  # - name: f446
  #   machine: nucleo_f446re
  #   binding: stm32cube
  #   triple: thumbv7em-none-eabihf
  #   options:
  #     configuration: Debug
  #     cube_project: /path/to/F446_Sample

  # boards: takes serial ports here, because that is what a board reached through the
  # Arduino core is written to over. With nothing here the one attached board this
  # firmware was built for is found, which is what keeps a Pico on the next port from
  # ever being a candidate.
  # - name: mega
  #   machine: mega2560
  #   binding: arduino
  #   triple: avr-none

  # The same board under two entries, reached two ways. Both can be recorded at once:
  # they build into directories of their own and write the same board, and a program says
  # nothing about which of them it was compiled for.
  # - name: esp32s3
  #   machine: esp32_s3_wroom
  #   binding: esp_idf
  #   triple: xtensa-esp32s3-elf
  # - name: esp32s3_arduino
  #   machine: esp32_s3_wroom
  #   binding: arduino
  #   triple: xtensa-esp32s3-elf
