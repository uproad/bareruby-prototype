#!/usr/bin/env bash
# Run the whole cycle for one BareRuby program: first stage, second stage, flash.
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

usage() {
    cat >&2 <<'USAGE'
Usage: brd SOURCE.rb [-d|--debug] [--target=NAME]...

Compiles one BareRuby program, builds the board firmware and flashes it.

  -d, --debug     Build the debug firmware. The board keeps its USB interface up
                  while the program runs, so it can be reflashed without holding
                  BOOTSEL. Costs about 27 KB of flash.
  --target=NAME   Build for NAME: host, raspberry-pi-pico or raspberry-pi-pico2.
                  Repeatable. Without it the targets come from target.yml. Only
                  board targets have firmware to build, and each is flashed onto
                  the attached board its chip belongs to, so several boards can be
                  brought up to date in one run. See './flash.sh --list'.

Environment:
  PICO_SDK_PATH         pico-sdk 2.x, defaults to ~/pico/pico-sdk-2
  PICO_TOOLCHAIN_PATH   defaults to ~/toolchains/arm-gnu-toolchain-13.2.Rel1-x86_64-arm-none-eabi
USAGE
    exit 2
}

DEBUG=()
TARGETS=()
SOURCE=""
for argument in "$@"; do
    case "$argument" in
        -d|--debug) DEBUG=(-d) ;;
        --target=*) TARGETS+=("$argument") ;;
        -*)
            echo "brd: unknown option: $argument" >&2
            usage
            ;;
        *) SOURCE=$(realpath "$argument") ;;
    esac
done

[ -n "$SOURCE" ] || usage

# One SDK serves both boards: RP2350 needs 2.0.0 or newer, and RP2040 is still
# supported there, so there is no reason to keep a second checkout for it.
: "${PICO_SDK_PATH:=$HOME/pico/pico-sdk-2}"
: "${PICO_TOOLCHAIN_PATH:=$HOME/toolchains/arm-gnu-toolchain-13.2.Rel1-x86_64-arm-none-eabi}"

# SDK 2.x builds picotool on demand. Left alone it lands inside the target's build
# tree, which the next first-stage run deletes, so it is kept outside of it instead.
: "${PICOTOOL_FETCH_FROM_GIT_PATH:=$HOME/pico/picotool}"
export PICO_SDK_PATH PICO_TOOLCHAIN_PATH PICOTOOL_FETCH_FROM_GIT_PATH

for path in "$PICO_SDK_PATH" "$PICO_TOOLCHAIN_PATH"; do
    if [ ! -d "$path" ]; then
        echo "brd: no such directory: $path" >&2
        echo "     See README.md for how to install the toolchain." >&2
        exit 1
    fi
done

echo "brd: first stage"
ruby "$HERE/compile.rb" "${DEBUG[@]}" "${TARGETS[@]}" "$SOURCE"

# A directory with a CMakeLists.txt is a board target: the hosted one is built by
# hand from its manifest and has nothing here to drive.
mapfile -t FIRMWARE_DIRECTORIES < <(
    find "$HERE/build" -mindepth 2 -maxdepth 2 -name CMakeLists.txt -printf '%h\n' | sort
)

# cmake and pico-sdk are chatty even when everything is fine. Keep the output for
# the failure case and say nothing otherwise.
run_quietly() {
    local output
    if ! output=$("$@" 2>&1); then
        echo "$output" >&2
        return 1
    fi
}

for directory in "${FIRMWARE_DIRECTORIES[@]}"; do
    echo "brd: second stage ($(basename "$directory"))"
    cd "$directory"
    run_quietly cmake -B build -S .
    run_quietly cmake --build build
done

# Each image says which chip it is for, so flash.sh can find its own board among the
# ones attached. Several boards therefore take their firmware in one run.
if [ "${#FIRMWARE_DIRECTORIES[@]}" -eq 0 ]; then
    echo "brd: no board target was selected, so there is no firmware to flash."
fi

for directory in "${FIRMWARE_DIRECTORIES[@]}"; do
    echo "brd: flash ($(basename "$directory"))"
    "$HERE/flash.sh" "$directory/build/bareruby_program.uf2"
done
